# ─────────────────────────────────────────────────────────────
#  Social Media Video Funnel — Environment Variables
#  Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────────

# ── AI / Claude ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Royalty-Free Media ───────────────────────────────────────
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── Instagram ────────────────────────────────────────────────
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ── YouTube ──────────────────────────────────────────────────
# Path to your OAuth2 client secrets JSON from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=config/youtube_client_secrets.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json

# ── TikTok ───────────────────────────────────────────────────
# Obtain via OAuth2 flow at https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# ── Platform Toggle (comma-separated) ───────────────────────
# Options: instagram, youtube, tiktok
ENABLED_PLATFORMS=instagram,youtube,tiktok
