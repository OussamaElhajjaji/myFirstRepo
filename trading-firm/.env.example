# ============================================================
# POLYMARKET TRADING FIRM — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.
# ============================================================

# ---- REQUIRED: Anthropic API (https://console.anthropic.com) ----
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---- REQUIRED: Polymarket CLOB credentials ----
# Get these from: https://docs.polymarket.com/#authentication
POLYMARKET_PRIVATE_KEY=your_evm_private_key_here
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_API_PASSPHRASE=your_polymarket_api_passphrase_here
WALLET_ADDRESS=your_polygon_wallet_address_here

# ---- Auto-generated on first run (do not fill manually) ----
# PORTFOLIO_HMAC_KEY=

# ---- Trading mode ----
# Set to False to trade with real money (requires live credentials above)
PAPER_TRADING=True

# ---- Risk profile: conservative | moderate | aggressive ----
RISK_PROFILE=moderate

# ---- Starting balance (for paper trading and circuit breaker) ----
STARTING_BALANCE=1000.0

# ---- Operational settings ----
LOOP_INTERVAL_SEC=120
MIN_EDGE_THRESHOLD=0.05
MIN_CONSENSUS_SCORE=0.65
MAX_MARKETS_PER_RUN=10

# ---- Logging ----
LOG_DIR=logs
